.version 8.0
.target sm_80
.address_size 64

.visible .entry setp_u64_kernel(
	.param .u64 setp_u64_kernel_param_0
)
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<4>;
	.reg .pred 	%p<1>;

	ld.param.u64 	%rd1, [setp_u64_kernel_param_0];
	mov.u64 	%rd2, 18446744073709551615;
	mov.u64 	%rd3, 1;
	setp.lt.u64 	%p1, %rd2, %rd3;
	selp.u32 	%r1, 1, 0, %p1;
	st.global.u32 	[%rd1], %r1;
	ret;
}
