.version 8.0
.target sm_80
.address_size 64

.visible .entry cvt_u16_u32_kernel(
	.param .u64 cvt_u16_u32_kernel_param_0,
	.param .u64 cvt_u16_u32_kernel_param_1,
	.param .u64 cvt_u16_u32_kernel_param_2
)
{
	.reg .b32 	%r<6>;
	.reg .b16 	%rs<6>;
	.reg .b64 	%rd<4>;

	ld.param.u64 	%rd1, [cvt_u16_u32_kernel_param_0];
	ld.param.u64 	%rd2, [cvt_u16_u32_kernel_param_1];
	ld.param.u64 	%rd3, [cvt_u16_u32_kernel_param_2];
	mov.u32 	%r1, 4660;
	cvt.u16.u32 	%rs1, %r1;
	shr.s16 	%rs2, %rs1, 6;
	mov.u32 	%r2, %rs2;
	st.global.u32 	[%rd1], %r2;
	shr.u16 	%rs3, %rs1, 4;
	mov.u32 	%r2, %rs3;
	st.global.u32 	[%rd2], %r2;
	mov.u32 	%r3, 1;
	cvt.u16.u32 	%rs4, %r3;
	add.s16 	%rs5, %rs1, %rs4;
	mul.wide.s16 	%r5, %rs5, 64;
	st.global.u32 	[%rd3], %r5;
	ret;
}
