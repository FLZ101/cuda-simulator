.version 8.0
.target sm_80
.address_size 64

.visible .entry mov_pred_kernel(
	.param .u64 mov_pred_kernel_param_0
)
{
	.reg .b32 	%r<2>;
	.reg .b64 	%rd<1>;
	.reg .pred 	%p<3>;

	ld.param.u64 	%rd1, [mov_pred_kernel_param_0];
	mov.u32 	%r1, 3;
	mov.pred 	%p1, 1;
	mov.pred 	%p2, %p1;
	@%p2 st.global.u32 	[%rd1], %r1;

	mov.pred 	%p1, 0;
	mov.pred 	%p2, %p1;
	mov.u32 	%r1, 4;
	@%p2 st.global.u32 	[%rd1], %r1;
	mov.pred 	%p1, -1;
	mov.pred 	%p2, %p1;
	mov.u32 	%r1, 5;
	@%p2 st.global.u32 	[%rd1], %r1;
	ret;
}
