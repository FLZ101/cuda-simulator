.version 8.0
.target sm_80
.address_size 64

.visible .entry selp_f32_kernel(
	.param .u64 selp_f32_kernel_param_0
)
{
	.reg .f32 	%f<4>;
	.reg .b64 	%rd<1>;
	.reg .pred 	%p<2>;

	ld.param.u64 	%rd1, [selp_f32_kernel_param_0];
	mov.b32 	%f1, 0f3F800000;
	mov.b32 	%f2, 0f40000000;
	mov.pred 	%p1, 1;
	selp.f32 	%f3, %f1, %f2, %p1;
	st.global.f32 	[%rd1], %f3;
	ret;
}
