#!/bin/sh
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
  echo "clang-format is required for pre-commit formatting" >&2
  exit 1
fi

files=$(git diff --cached --name-only --diff-filter=ACM |
  grep -E '\.(c|cc|cpp|h|hh|hpp)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

clang-format -i $files
git add $files
